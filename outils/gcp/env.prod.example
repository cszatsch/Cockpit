# Configuration de production (docker-compose.prod.yml). Copier en .env.prod à la racine du dépôt, sur la VM :
#   cp outils/gcp/env.prod.example .env.prod && chmod 600 .env.prod
# .env.prod n'est jamais versionné ni copié ailleurs. AUTH_DEV, DEMO_TODAY, OFFLINE, JOBS_ENABLED, COOKIE_SECURE,
# TRUST_PROXY et DATABASE_URL sont imposés par docker-compose.prod.yml.

# Nom de domaine public (enregistrement DNS A vers l'adresse IP statique de la VM) et e-mail pour Let's Encrypt
DOMAINE=cockpit.example.fr
EMAIL_ACME=

# Mot de passe PostgreSQL : caractères hexadécimaux seulement (il entre dans l'URL de connexion)
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Secret des jetons de session : openssl rand -hex 32
JWT_SECRET=
JWT_TTL=12h

# Clé maître AES-256-GCM des clés API et du mot de passe SMTP (64 caractères hexadécimaux).
# Reprise de la base du poste : recopier la valeur de backend/.env du poste, sinon les clés enregistrées sont illisibles.
# Base neuve : openssl rand -hex 32. À conserver aussi hors de la VM (gestionnaire de mots de passe) : sans elle,
# une sauvegarde restaurée ne peut plus déchiffrer ses clés.
SECRETS_KEY=

# Envoi d'e-mails (le port 25 sortant est bloqué par Google Cloud : 587 ou 465). La page Console › Serveur SMTP
# fait foi dès qu'elle est enregistrée ; ces valeurs ne servent qu'au démarrage.
SMTP_HOST=
SMTP_PORT=587
# starttls (587) ou ssl (465)
SMTP_ENC=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_FROM=Cockpit <no-reply@example.fr>

# Mots de passe compromis vérifiés auprès de Have I Been Pwned (k-anonymat)
PWNED_CHECK=true
PREFILL_RETENTION_HOURS=24

# Sauvegardes (outils/gcp/sauvegarde.sh) : bucket Cloud Storage et nombre de jours gardés sur la VM
BUCKET_SAUVEGARDES=gs://nom-du-bucket-rise
JOURS_LOCAUX=7
