// RISE — schéma de données commun au Cockpit et à la Console Admin.
// Conventions :
//  - identifiants : chaînes stables (ids historiques du jeu de démonstration, sinon générés par le serveur) ;
//  - dates métier : chaînes ISO 8601 `YYYY-MM-DD` (jamais de libellé) ; horodatages : DateTime UTC ;
//  - `*Prec` : précision d'affichage d'une date saisie au mois ou à l'année dans le Référentiel (D | M | Y) ;
//  - `version` : verrouillage optimiste (ETag / If-Match) ;
//  - enums : codes anglais majuscules.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  PREPARATION
  ACTIVE
  CLOSED
}

enum PlanStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

enum WorkstreamStatus {
  ACTIVE
  CLOSED
}

enum DatePrecision {
  D
  M
  Y
}

enum TeamKind {
  CLIENT
  AMOA
  INTEGRATOR
  OTHER
}

enum Frequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ON_DEMAND
}

enum BodyLevel {
  STRATEGIC
  STEERING
  OPERATIONAL
  OFF_CYCLE
}

enum MemberRole {
  CHAIR
  MEMBER
  SECRETARY
  GUEST
}

enum RiskStatus {
  OPEN
  MITIGATING
  CLOSED
}

enum IssueStatus {
  OPEN
  RESOLVING
  RESOLVED
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum SourceType {
  RISK
  ISSUE
  MILESTONE
  DECISION
}

enum DecisionStatus {
  DRAFT
  IN_REVIEW
  TO_ARBITRATE
  ARBITRATED
  CANCELLED
  SUPERSEDED
}

enum SessionStatus {
  PLANNED
  HELD
  CANCELLED
}

enum ReportStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
}

enum DeliverableRisk {
  OK
  TENSION
  CRITICAL
}

enum MissionStatus {
  INVOICED
  IN_PROGRESS
  NEGOTIATION
}

enum Confidentiality {
  INTERNAL
  RESTRICTED
}

enum DocumentSource {
  UPLOADED
  GENERATED
}

enum ExtractionStatus {
  PENDING
  SUCCEEDED
  PARTIAL
  UNSUPPORTED
  /// Traitement en échec (extraction, résumé ou vectorisation) : aucune donnée partielle gardée, motif dans `error`.
  FAILED
}

enum TaskStatus {
  TODO
  DONE
}

enum AccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum Profile {
  ADMIN
  PMO
  RESPONSABLE
  LECTEUR
}

enum AuditOrigin {
  MANUAL
  JEV
  IMPORT
  SYSTEM
}

enum Severity {
  INFO
  SENSITIVE
  CRITICAL
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProviderStatus {
  OK
  ERROR
  UNTESTED
}

enum UsageSource {
  COCKPIT
  JEV
  NOTIFICATION
  IMPORT
  GUIDE
}

enum SnapshotKind {
  AUTO
  MANUAL
}

enum SnapshotStatus {
  RUNNING
  DONE
  FAILED
}

enum RuleFrequency {
  DAILY
  WEEKLY
  CUSTOM
}

enum Channel {
  APP
  EMAIL
}

enum DeliveryStatus {
  OK
  ERROR
  /// Envoi planifié remplacé par une occurrence plus récente (rattrapage) : rien n'est parti.
  SKIPPED
}

enum ModuleScope {
  OFF
  ALL
  PROJECTS
}

enum ImportStatus {
  CHECKED
  REJECTED
  IMPORTED
}

enum ChangeStatus {
  PROPOSED
  CONFIRMED
  REJECTED
}

// ─────────────────────────── Référentiel ───────────────────────────

model Client {
  id          String       @id
  code        String       @unique
  name        String
  description String?
  status      ActiveStatus @default(ACTIVE)
  projects    Project[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  version     Int          @default(1)
}

model Project {
  id                String        @id
  clientId          String
  client            Client        @relation(fields: [clientId], references: [id])
  code              String        @unique
  name              String
  objective         String?
  startDate         String
  targetEndDate     String
  timezone          String        @default("Europe/Paris")
  city              String?
  country           String        @default("France")
  status            ProjectStatus @default(PREPARATION)
  editorTeamId      String?
  integratorTeamId  String?
  programDirectorId String?
  sponsorId         String?
  currency          String        @default("EUR")
  forecastGoliveIso String?
  /// { value, reason, by, at } — `reason` obligatoire
  healthOverride    Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  version           Int           @default(1)

  sections      ProjectSection[]
  baselines     BaselineVersion[]
  waves         Wave[]
  phases        Phase[]
  subphases     Subphase[]
  workstreams   Workstream[]
  milestones    Milestone[]
  deliverables  Deliverable[]
  teams         Team[]
  roles         ProjectRole[]
  persons       Person[]
  assignments   Assignment[]
  bodies        GovernanceBody[]
  habilitations Habilitation[]
  contentBlocks ContentBlock[]
}

/// Sections libres de la fiche projet. Clé = identifiant stable d'un champ de la fiche (surcharge éditée).
model ProjectSection {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String
  label     String?
  value     Json
  order     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([projectId, key])
}

model BaselineVersion {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version      String
  date         String
  approvedAt   String?
  approvedById String?
  reason       String?
  current      Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([projectId, version])
}

/// Données de présentation sans règle de calcul (brief Cockpit § 12) : committee, volets, riskStats,
/// weekWins, referential.*, raci, modelGaps, métadonnées d'affichage de model.*, missionNext…
model ContentBlock {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String
  data      Json
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@unique([projectId, key])
}

model Wave {
  id        String        @id
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seq       Int
  name      String
  startDate String?
  startPrec DatePrecision @default(D)
  endDate   String?
  endPrec   DatePrecision @default(D)
  status    PlanStatus    @default(PLANNED)
  ownerId   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  version   Int           @default(1)

  phases      PhaseWave[]
  workstreams WorkstreamWave[]

  @@unique([projectId, seq])
}

model Phase {
  id                 String        @id
  projectId          String
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seq                Int
  code               String
  name               String
  description        String?
  startDate          String
  startPrec          DatePrecision @default(D)
  endDate            String
  endPrec            DatePrecision @default(D)
  status             PlanStatus    @default(PLANNED)
  progressPct        Int           @default(0)
  /// Q8 : avancement prévu forcé (planning)
  plannedPctOverride Int?
  critical           Boolean       @default(false)
  ownerId            String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  version            Int           @default(1)

  waves       PhaseWave[]
  subphases   Subphase[]
  workstreams WorkstreamPhase[]
  milestones  Milestone[]

  @@unique([projectId, seq])
}

/// Relation N-N Phase ↔ Lot ; Q8 : dates de la phase propres au lot (facultatives).
model PhaseWave {
  phaseId   String
  phase     Phase          @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  waveId    String
  wave      Wave           @relation(fields: [waveId], references: [id], onDelete: Cascade)
  startDate String?
  startPrec DatePrecision?
  endDate   String?
  endPrec   DatePrecision?

  @@id([phaseId, waveId])
}

model Subphase {
  id                 String        @id
  projectId          String
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId            String
  phase              Phase         @relation(fields: [phaseId], references: [id])
  code               String
  name               String
  description        String?
  startDate          String?
  startPrec          DatePrecision @default(D)
  endDate            String?
  endPrec            DatePrecision @default(D)
  status             PlanStatus    @default(PLANNED)
  progressPct        Int           @default(0)
  plannedPctOverride Int?
  critical           Boolean       @default(false)
  ownerId            String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  version            Int           @default(1)

  milestones   Milestone[]
  deliverables Deliverable[]

  @@unique([projectId, code])
}

model Workstream {
  id                 String           @id
  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code               String
  seq                Int
  name               String
  ownerId            String
  status             WorkstreamStatus @default(ACTIVE)
  startDate          String?
  endDate            String?
  progressPct        Int              @default(0)
  plannedPctOverride Int?
  critical           Boolean          @default(false)
  description        String?
  dependsOnAll       Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  version            Int              @default(1)

  phases       WorkstreamPhase[]
  waves        WorkstreamWave[]
  dependencies WorkstreamDependency[] @relation("dependent")
  dependents   WorkstreamDependency[] @relation("dependency")

  @@unique([projectId, code])
}

model WorkstreamPhase {
  wsId    String
  ws      Workstream @relation(fields: [wsId], references: [id], onDelete: Cascade)
  phaseId String
  phase   Phase      @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@id([wsId, phaseId])
}

model WorkstreamWave {
  wsId   String
  ws     Workstream @relation(fields: [wsId], references: [id], onDelete: Cascade)
  waveId String
  wave   Wave       @relation(fields: [waveId], references: [id], onDelete: Cascade)

  @@id([wsId, waveId])
}

model WorkstreamDependency {
  wsId        String
  ws          Workstream @relation("dependent", fields: [wsId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   Workstream @relation("dependency", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([wsId, dependsOnId])
}

/// Bloc « Avancement » (8 lignes) ; `sig` calculé (Q9).
model WorkstreamProgress {
  id          String    @id
  projectId   String
  wsId        String
  label       String
  valuePct    Int
  targetPct   Int
  detail      String?
  ownerId     String?
  order       Int       @default(0)
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(1)
}

model Milestone {
  id          String    @id
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code        String
  n           String
  phaseId     String
  phase       Phase     @relation(fields: [phaseId], references: [id])
  subphaseId  String?
  subphase    Subphase? @relation(fields: [subphaseId], references: [id])
  wsId        String?
  waveId      String?
  ownerId     String?
  iso         String
  baselineIso String
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(1)

  @@unique([projectId, code])
}

model Deliverable {
  id           String           @id
  projectId    String
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  subphaseId   String
  subphase     Subphase         @relation(fields: [subphaseId], references: [id])
  workstreamId String?
  ownerId      String
  start        String?
  due          String
  prog         Int              @default(0)
  riskOverride DeliverableRisk?
  /// Libellé d'équipe affiché (colonne « équipe » du Référentiel), dérivé si vide.
  teamLabel    String?
  order        Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  version      Int              @default(1)
}

model Team {
  id          String   @id
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Q8 : type d'équipe utilisé par le Dispositif (client / AMOA / intégrateur)
  kind        TeamKind @default(OTHER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  @@unique([projectId, name])
}

model ProjectRole {
  id          String   @id
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label       String
  description String?
  order       Int      @default(0)
  /// Q8 : niveau d'affichage dans l'organigramme (0-3)
  tier        Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  @@unique([projectId, label])
}

model Person {
  id        String   @id
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  email     String
  teamId    String?
  title     String?
  active    Boolean  @default(true)
  photoUrl  String?
  /// Chantiers de rattachement affichés dans la fiche personne (colonne « chantier »)
  wsIds     String[] @default([])
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@unique([projectId, email])
}

model Assignment {
  id        String   @id
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  personId  String
  roleId    String
  startDate String
  endDate   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  @@unique([personId, roleId, startDate])
}

model GovernanceBody {
  id          String     @id
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  shortName   String
  color       String
  frequency   Frequency
  level       BodyLevel?
  description String?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  version     Int        @default(1)

  members BodyMember[]

  @@unique([projectId, shortName])
}

model BodyMember {
  bodyId   String
  body     GovernanceBody @relation(fields: [bodyId], references: [id], onDelete: Cascade)
  personId String
  role     MemberRole     @default(MEMBER)
  order    Int            @default(0)

  @@id([bodyId, personId])
}

// ─────────────────────────── Transactionnel ───────────────────────────

model Risk {
  id        String     @id
  projectId String
  code      String
  n         String
  p         Int
  i         Int
  plan      String?
  ownerId   String
  wsId      String
  dueIso    String?
  status    RiskStatus @default(OPEN)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  version   Int        @default(1)

  @@unique([projectId, code])
}

model Issue {
  id              String      @id
  projectId       String
  code            String
  n               String
  sev             Int
  originRiskId    String?
  openedIso       String
  ownerId         String
  wsId            String
  targetIso       String?
  targetSessionId String?
  detail          String      @default("")
  status          IssueStatus @default(OPEN)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  version         Int         @default(1)

  @@unique([projectId, code])
}

model Action {
  id         String       @id
  projectId  String
  code       String
  n          String
  detail     String?
  ownerId    String
  /// Q2 : chantier obligatoire
  wsId       String
  dueIso     String?
  status     ActionStatus @default(OPEN)
  prio       Priority     @default(MEDIUM)
  sourceType SourceType?
  sourceId   String?
  closedAt   String?
  order      Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  version    Int          @default(1)

  @@unique([projectId, code])
}

model Decision {
  id                String         @id
  projectId         String
  code              String
  t                 String
  p                 Int
  status            DecisionStatus @default(DRAFT)
  crIso             String
  ddIso             String?
  wsId              String
  bodyId            String
  decL              String?
  makerId           String?
  impact            String?
  supersedesId      String?
  expectedSessionId String?
  full              Boolean        @default(false)
  opt               String?
  /// Fiche d'arbitrage : { question, options[], criteria[], recommendation, texts{} }
  arbitration       Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  version           Int            @default(1)

  @@unique([projectId, code])
}

model Session {
  id           String        @id
  projectId    String
  bodyId       String
  number       Int
  dateIso      String
  time         String?
  place        String?
  status       SessionStatus @default(PLANNED)
  participants String[]      @default([])
  reportId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  version      Int           @default(1)

  @@unique([bodyId, number])
}

model ReportTemplate {
  id          String   @id
  projectId   String
  name        String
  bodyId      String?
  authorId    String?
  authorLabel String?
  version     String   @default("v1")
  description String   @default("")
  /// [{ id, scope: PROJECT|WAVE|PHASE|WORKSTREAM, targetId? }] (Q8 : composant budget, portée PHASE)
  components  Json
  /// Format du rapport (02/10/2026) : { pages: { cover|divider|standard|closing: { fileId, slide, kind, analysis } } } ; null = présentation par défaut
  format      Json?
  pages       Int      @default(1)
  publishedAt String?
  active      Boolean  @default(true)
  order       Int      @default(0)
  /// Mise en service (04/10/2026) : PENDING → READY (ou FAILED) ; étape du serveur 0 à 4 (`domain/template-service.ts`)
  serviceStatus  String    @default("READY")
  servicePhase   Int       @default(0)
  serviceError   String?
  serviceReadyAt DateTime?
  /// Première génération d'un rapport (fin de l'étiquette « Nouveau »)
  firstReportAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rowVersion  Int      @default(1)
}

model ReportInstance {
  id            String       @id
  projectId     String
  templateId    String?
  sessionId     String
  name          String
  v             String       @default("v1")
  status        ReportStatus @default(DRAFT)
  generatedAt   DateTime     @default(now())
  reportingDate String?
  captureAt     DateTime?
  reviewerId    String?
  validatorId   String?
  audience      String?
  fileId        String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  version       Int          @default(1)
}

model BarometerSurvey {
  id           String   @id @default(cuid())
  projectId    String
  /// YYYY-MM
  month        String
  /// Clé et libellé d'affichage historiques (« nov », « nov. 25 »)
  key          String
  label        String
  overallScore Float?
  respondents  Int?
  /// { negative, neutral, positive } (somme = 100)
  sentiment    Json?
  /// [{ label, score, delta }]
  questions    Json?
  /// [{ label, tone: OK|WATCH|RISK }]
  themes       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  version      Int      @default(1)

  @@unique([projectId, month])
}

model BarometerDomain {
  id        String   @id @default(cuid())
  projectId String
  n         String
  size      Int      @default(0)
  resp      Int      @default(0)
  /// { "YYYY-MM": score | null }
  series    Json
  range     String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
}

model MissionPeriod {
  id        String        @id
  projectId String
  period    String
  amoa      Float
  sub       Float
  status    MissionStatus
  order     Int           @default(0)
  updatedAt DateTime      @updatedAt
  version   Int           @default(1)
}

model ProgramBudget {
  projectId String   @id
  known     Boolean  @default(false)
  reason    String?
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
}

model Document {
  id          String           @id
  projectId   String
  n           String
  type        String
  dateIso     String
  v           String           @default("v1")
  conf        Confidentiality  @default(INTERNAL)
  src         DocumentSource   @default(UPLOADED)
  ext         ExtractionStatus @default(PENDING)
  mime        String
  pages       Int?
  fileKey     String?
  sizeBytes   Int?
  /// Texte d'origine de la colonne « liens » quand il ne se résout pas en liens typés
  linkedLabel String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  version     Int              @default(1)

  // Base de connaissance (décisions du 30/09/2026) : dépôt, traitement, résumé et index.
  /// Format réel (PDF, DOCX, PPTX, XLSX) et nom du fichier déposé.
  format         String?
  fileName       String?   @map("file_name")
  /// Auteur et date du dépôt.
  uploadedById   String?   @map("uploaded_by_id")
  uploadedBy     String?   @map("uploaded_by")
  uploadedAt     DateTime? @map("uploaded_at")
  /// Empreinte SHA-256 du contenu (doublons).
  contentHash    String?   @map("content_hash")
  /// Résumé (affiché par « Vue ») et description en deux phrases (métadonnée de chaque extrait).
  summary        String?
  description    String?
  /// Motif d'échec, ou précision d'une extraction partielle.
  error          String?
  extNote        String?   @map("ext_note")
  /// Avancement du traitement (0 à 100) et étape.
  progress       Int?
  stepLabel      String?   @map("step_label")
  chunkCount     Int?      @map("chunk_count")
  embeddingModel String?   @map("embedding_model")
  embeddingName  String?   @map("embedding_name")
  embeddingDims  Int?      @map("embedding_dims")
  /// Remplacement : document remplacé une fois celui-ci indexé.
  replacesId     String?   @map("replaces_id")

  links  DocumentLink[]
  chunks KbChunk[]

  @@index([projectId, contentHash])
}

/// Extrait vectorisé d'un document de la Base de connaissance (pgvector, index HNSW partiel par dimension).
model KbChunk {
  id         String                @id
  documentId String                @map("document_id")
  projectId  String                @map("project_id")
  position   Int
  section    String
  heading    String
  pageStart  Int?                  @map("page_start")
  pageEnd    Int?                  @map("page_end")
  slide      Int?
  sheet      String?
  rowStart   Int?                  @map("row_start")
  rowEnd     Int?                  @map("row_end")
  content    String
  /// Métadonnées : document, date de dépôt, description, et section / page, diapositive ou onglet.
  metadata   Json
  tokens     Int
  dims       Int
  model      String
  embedding  Unsupported("vector")
  document   Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([projectId])
  @@map("kb_chunks")
}

/// Historique de la Base de connaissance : dépôts, refus, remplacements, indexations, échecs, suppressions
/// (journal en ajout seul, trigger SQL).
model DocumentEvent {
  id           String   @id
  at           DateTime
  projectId    String   @map("project_id")
  documentId   String?  @map("document_id")
  documentName String   @map("document_name")
  accountId    String?  @map("account_id")
  by           String
  /// DEPOT, REFUS, REMPLACEMENT, INDEXE, ECHEC, SUPPRESSION
  action       String
  status       String
  detail       String?

  @@index([projectId, at])
  @@map("document_events")
}

model DocumentLink {
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String

  @@id([documentId, entityType, entityId])
}

/// Tâche manuelle, visible par son auteur seulement.
model Task {
  id        String     @id
  projectId String
  authorId  String
  title     String
  dueIso    String?
  detail    String?
  status    TaskStatus @default(TODO)
  /// { entityType, entityId }
  link      Json?
  cta       String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  version   Int        @default(1)
}

/// Q8 : surcharge personnelle d'une tâche calculée (archivage, renommage).
model TaskOverride {
  id         String   @id @default(cuid())
  projectId  String
  personId   String
  entityType String
  entityId   String
  archived   Boolean  @default(false)
  title      String?
  detail     String?
  dueIso     String?
  cta        String?
  updatedAt  DateTime @updatedAt

  @@unique([personId, entityType, entityId])
}

model CellComment {
  id         String   @id @default(cuid())
  projectId  String
  entityType String
  entityId   String
  field      String
  text       String
  authorId   String
  authorName String
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model UserPreferences {
  accountId       String   @id
  dashboardLayout Json?
  theme           Json?
  firstName       String?
  city            String?
  photoUrl        String?
  notifications   Json?
  language        String?
  timezone        String?
  updatedAt       DateTime @updatedAt
}

model AssistantChange {
  id         String       @id @default(cuid())
  projectId  String
  accountId  String
  entityType String
  entityId   String?
  op         String
  patch      Json
  summary    String
  status     ChangeStatus @default(PROPOSED)
  createdAt  DateTime     @default(now())
  decidedAt  DateTime?
}

model AssistantFile {
  id        String   @id @default(cuid())
  projectId String?
  accountId String
  name      String
  mime      String
  fileKey   String
  status    String   @default("READY")
  createdAt DateTime @default(now())
}

// ─────────────────────────── Accès (communs) ───────────────────────────

model Account {
  id                 String        @id
  email              String        @unique
  fullName           String
  personId           String?
  status             AccountStatus @default(INVITED)
  invitedAt          DateTime?
  inviteExpiresAt    DateTime?
  lastLoginAt        DateTime?
  photoUrl           String?
  /// Profil de l'administrateur (fonction, société, téléphone, ville, pays, langue, fuseau)
  profile            Json?
  /// Empreinte Argon2id du mot de passe (null : mot de passe jamais défini, connexion impossible)
  passwordHash       String?
  /// Changement de mot de passe exigé à la prochaine connexion (compte initial, mot de passe provisoire)
  mustChangePassword Boolean       @default(false)
  passwordChangedAt  DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  version            Int           @default(1)

  projects         AccountProject[]
  sessions         AuthSession[]
  passwordTokens   PasswordToken[]
  jevConversations JevConversation[]
}

model AccountProject {
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  projectId String

  @@id([accountId, projectId])
}

/// Habilitation (brief § 8.3) : RESPONSABLE et LECTEUR exigent un chantier.
/// ADMIN est porté par AdminGrant (plateforme) ; les lignes ADMIN éventuelles sont ignorées par le calcul.
model Habilitation {
  id        String   @id
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  personId  String?
  accountId String?
  profile   Profile
  wsId      String?
  createdAt DateTime @default(now())
}

model AdminGrant {
  accountId   String   @id
  since       DateTime @default(now())
  grantedById String?
}

model AuthSession {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  device     String?
  location   String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  /// Surface de connexion : APP (Cockpit) ou ADMIN (Console) ; null pour les sessions de développement
  surface    String?
  /// Session limitée au changement de mot de passe obligatoire (première connexion)
  restricted Boolean   @default(false)
  /// Rotation du jeton : incrémentée à chaque renouvellement, l'ancien cookie devient invalide
  rotation   Int       @default(0)
}

/// Lien de réinitialisation ou d'invitation : jeton aléatoire de 256 bits, stocké haché (SHA-256), à usage unique.
model PasswordToken {
  id        String    @id @default(cuid())
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  /// RESET (mot de passe oublié) ou INVITE (invitation de la Console)
  purpose   String
  /// Surface d'origine (APP ou ADMIN) : l'écran de réinitialisation y renvoie
  surface   String    @default("APP")
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([accountId, createdAt])
}

/// Compteur d'échecs de connexion : clé « email:<adresse> » (comptes existants ou non) ou « ip:<adresse> ».
model LoginThrottle {
  key         String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

/// Q8 bis : demande d'invitation émise depuis le Référentiel du Cockpit.
model InvitationRequest {
  id            String        @id @default(cuid())
  projectId     String
  personId      String
  requestedById String
  status        RequestStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  decidedAt     DateTime?
  decidedById   String?
}

/// Journal d'audit — ajout seul (trigger SQL refusant UPDATE/DELETE).
model AuditEntry {
  id          String      @id @default(cuid())
  at          DateTime    @default(now())
  accountId   String?
  actorName   String
  personId    String?
  profileUsed String?
  origin      AuditOrigin @default(MANUAL)
  severity    Severity    @default(INFO)
  action      String
  target      String?
  projectId   String?
  wsId        String?
  entityType  String
  entityId    String?
  field       String?
  oldValue    Json?
  newValue    Json?

  @@index([projectId, entityType, entityId])
  @@index([at])
}

// ─────────────────────────── Console Admin ───────────────────────────

model Provider {
  id           String         @id
  name         String
  keyPrefix    String?
  keyLast4     String?
  keyCipher    String?
  status       ProviderStatus @default(UNTESTED)
  latencyMs    Int?
  lastTestedAt DateTime?
  lastError    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  version      Int            @default(1)
}

/// Catégorie d'un modèle : seuls les LLM génèrent du texte (fonctions du Cockpit, notifications).
enum ModelCategory {
  LLM
  EMBEDDING
  RERANKING
}

/// Unité de facturation : au token (€ / M tokens) ou à la requête (€ / 1 000 requêtes, Reranking).
enum PriceUnit {
  TOKENS
  REQUESTS
}

model AiModel {
  id                 String        @id
  providerId         String
  name               String
  description        String        @default("")
  category           ModelCategory @default(LLM)
  /// Date de sortie du modèle (ancienneté) ; null pour les modèles saisis avant ce champ
  releaseDate        DateTime?     @db.Date
  /// Longueur maximale d'une réponse, LLM uniquement
  maxOutputTokens    Int?
  /// Identifiant du modèle chez le fournisseur (ex. qwen/qwen3-embedding-8b)
  providerModelId    String?
  /// Longueur de contexte (tokens)
  contextTokens      Int?
  /// Dimensions de sortie acceptées (Embedding) ; vide pour les autres catégories
  dimensions         Int[]         @default([])
  /// Dimension proposée par défaut (Embedding), comprise dans `dimensions`
  defaultDimension   Int?
  priceUnit          PriceUnit     @default(TOKENS)
  /// € / M tokens en entrée (unité TOKENS)
  priceInPerMTok     Float?
  /// € / M tokens en sortie (LLM uniquement)
  priceOutPerMTok    Float?
  /// € / 1 000 requêtes (unité REQUESTS, Reranking)
  pricePer1kRequests Float?
  active             Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  version            Int           @default(1)
}

model ModelAssignment {
  functionId        String   @id
  primaryModelId    String
  fallbackModelId   String?
  /// Taille des vecteurs produits (fonction Embedding) par le principal et par le secours
  primaryDimension  Int?
  fallbackDimension Int?
  updatedAt         DateTime @updatedAt
  version           Int      @default(1)
}

model UsageRecord {
  id           String      @id @default(cuid())
  at           DateTime
  projectId    String?
  functionId   String
  modelId      String
  providerId   String
  tokensIn     Int
  tokensOut    Int
  /// Requêtes facturées (Reranking à la requête)
  requests     Int         @default(0)
  costEur      Float
  fallbackUsed Boolean     @default(false)
  source       UsageSource
  /// Tarifs du modèle au moment de l'appel, figés (Journal des appels § 3) : € / M jetons en entrée, en sortie ;
  /// € / 1 000 requêtes (Reranking). Null pour les appels antérieurs au journal (tarif non enregistré).
  priceIn      Float?
  priceOut     Float?
  pricePer1k   Float?
  /// Latence totale de l'appel (ms) ; null si non mesurée
  durationMs   Int?
  /// Jetons d'entrée lus et écrits dans le cache du fournisseur (compris dans tokensIn), facturés au tarif du cache
  /// (lecture 10 %, écriture 125 % du prix d'entrée) : le calcul affiché du coût retombe exactement sur costEur.
  cacheReadTokens  Int     @default(0)
  cacheWriteTokens Int     @default(0)

  @@index([at])
  @@index([providerId, at])
  @@index([functionId, at])
}

model BudgetThreshold {
  id        String   @id
  limitEur  Float?
  warnPct   Int      @default(80)
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
}

model Snapshot {
  id         String         @id @default(cuid())
  projectId  String
  takenAt    DateTime       @default(now())
  kind       SnapshotKind
  label      String?
  takenById  String?
  takenBy    String?
  status     SnapshotStatus @default(DONE)
  storageKey String?
  stats      Json?
}

model SnapshotSchedule {
  projectId String   @id
  enabled   Boolean  @default(true)
  frequency String   @default("Hebdomadaire")
  day       String   @default("Vendredi")
  hour      String   @default("04:00")
  retention String   @default("12 mois")
  updatedAt DateTime @updatedAt
}

model NotificationRule {
  id             String        @id
  name           String
  targetProfiles String[]
  projectIds     String[]
  platform       Boolean       @default(false)
  modelId        String
  prompt         String
  subject        String
  body           String
  frequency      RuleFrequency
  day            String?
  hour           String?
  everyDays      Int?
  channels       Channel[]
  enabled        Boolean       @default(false)
  /// Prochain envoi d'une règle planifiée (heure de Paris), calculé à l'enregistrement et après chaque envoi ; null sinon.
  nextRunAt      DateTime?
  /// Fréquence, jour et heure qui ont servi à calculer nextRunAt : s'ils changent, il est recalculé.
  scheduleKey    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  version        Int           @default(1)

  @@index([enabled, nextRunAt])
}

model Delivery {
  id              String         @id @default(cuid())
  ruleId          String
  at              DateTime       @default(now())
  channel         Channel
  recipientsCount Int
  status          DeliveryStatus
  error           String?
  costEur         Float          @default(0)
  tokens          Int            @default(0)
  projectId       String?
  subject         String?
  body            String?
  /// Clé de dédoublonnage d'un événement (ex. « n1|RISE|J03 ») : un seul envoi par événement.
  /// Profil destinataire de l'envoi (un texte par profil, droits du profil) : admin, pmo, resp, lec
  profile         String?
  eventKey        String?
  /// Envoi planifié : heure prévue, et mode ON_TIME (à l'heure), CATCH_UP (rattrapé), REPLACED (remplacé), MISSED (abandonné).
  scheduledAt     DateTime?
  mode            String?
  /// Texte rédigé par le modèle ({reponse_llm}) : mémoire de la rédaction de l'envoi suivant.
  llmResponse     String?
  recipients      String[]       @default([])

  @@index([ruleId, eventKey])
}

model Module {
  id          String          @id
  name        String
  description String
  scope       ModuleScope     @default(OFF)
  globalSince DateTime?
  updatedAt   DateTime        @updatedAt
  version     Int             @default(1)
  projects    ModuleProject[]
}

model ModuleProject {
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  projectId String
  since     DateTime @default(now())

  @@id([moduleId, projectId])
}

model ModuleRequest {
  id            String        @id @default(cuid())
  moduleId      String
  projectId     String
  requestedById String?
  requestedBy   String
  at            DateTime      @default(now())
  status        RequestStatus @default(PENDING)
  decidedAt     DateTime?
}

model ProjectImport {
  id         String       @id @default(cuid())
  fileName   String
  fileKey    String
  uploadedBy String
  uploadedAt DateTime     @default(now())
  status     ImportStatus
  report     Json
  parsed     Json?
  projectId  String?
}

// ─────────────────────────── Assistant (Jev) ───────────────────────────

/// Skill de Jev : consigne ajoutée au prompt système de Jev (spécification SKILLS § 5).
/// Nom ≤ 60 caractères, texte ≤ 20 000 ; seules les skills actives sont envoyées, dans l'ordre de `position`.
model Skill {
  id        String   @id @default(cuid())
  n         String
  t         String   @default("")
  on        Boolean  @default(false)
  position  Int
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
}

/// Persona de Jev (spécification PERSONA § 5) : un seul pour la plateforme (id « jev »).
/// Identity (nom ≤ 30 requis, créature ≤ 40, style ≤ 60, emoji, avatar prédéfini, photo importée) et Soul (≤ 20 000).
model Persona {
  id        String   @id @default("jev")
  name      String
  creature  String   @default("")
  style     String   @default("")
  emoji     String   @default("")
  avatar    String   @default("nuit")
  photo     String?
  soul      String   @default("")
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
}

/// Versions précédentes du Persona : l'état remplacé à chaque enregistrement, pour revenir en arrière.
model PersonaVersion {
  id      String   @id @default(cuid())
  version Int
  data    Json
  savedAt DateTime @default(now()) @map("saved_at")
  savedBy String?  @map("saved_by")

  @@index([savedAt])
}

// ─────────────────────────── Notifications de l'administrateur ───────────────────────────

enum AdminNotificationKind {
  ERR
  WARN
  INVITE
  MODULE
}

/// OPEN : à traiter ; DECIDED : décision prise, annulable jusqu'à `undoUntil` ; DONE : décision exécutée ;
/// RESOLVED : cause disparue ou demande traitée ailleurs.
enum AdminNotificationStatus {
  OPEN
  DECIDED
  DONE
  RESOLVED
}

/// Notification du tiroir de la console (spécification NOTIFICATIONS) : incident, alerte, demande d'invitation
/// ou d'activation de module. Une par cause (`key`), rouverte si la cause réapparaît.
model Notification {
  id          String                  @id @default(cuid())
  key         String                  @unique
  kind        AdminNotificationKind
  status      AdminNotificationStatus @default(OPEN)
  title       String
  text        String
  note        String?
  actLabel    String?
  target      String?
  meta        Json?
  /// Niveau d'une alerte (ex. WARN, OVER) : une aggravation la remet en « non lue ».
  level       String?
  readAt      DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  decision    String?
  decidedAt   DateTime?
  decidedById String?
  decidedBy   String?
  undoUntil   DateTime?
  doneAt      DateTime?
  resolvedAt  DateTime?
  /// Effacée du tiroir par un administrateur (« Effacer toutes les notifications ») : masquée tant que sa cause dure ;
  /// réaffichée si la cause disparaît puis revient, ou si elle s'aggrave.
  clearedAt   DateTime?

  @@index([status])
}

// ─────────────────────────── Registre des cartes API ───────────────────────────

/// Service externe appelé par les widgets (spécification REGISTRE API § 3). La clé est chiffrée
/// (AES-256-GCM, clé maître SECRETS_KEY) et ne quitte jamais le serveur : seuls ses 4 derniers caractères sont exposés.
model ApiCard {
  id            String    @id
  name          String
  category      String
  endpoint      String
  keyEncrypted  String?   @map("key_encrypted")
  keyLast4      String?   @map("key_last4")
  keyExpiresAt  DateTime? @map("key_expires_at") @db.Date
  enabled       Boolean   @default(true)
  /// Échec du dernier contrôle (« Clé refusée · 401 ») ; null si le dernier appel a réussi.
  checkError    String?   @map("check_error")
  latencyMs     Int?      @map("latency_ms")
  quotaLimit    Int?      @map("quota_limit")
  /// Délai d'un appel pour cette carte (ms) ; null = délai par défaut (8 s). Service lent : GDELT (45 s).
  timeoutMs     Int?      @map("timeout_ms")
  /// Envoi de la clé : HEADER (en-tête X-Api-Key, ou marqueur {key} de l'endpoint) ou BEARER (Authorization: Bearer).
  authMode      String    @default("HEADER") @map("auth_mode")
  /// Méthode des appels : GET (widgets) ou POST (service qui attend un corps JSON, ex. TypeSafe).
  method        String    @default("GET")
  /// Corps JSON envoyé en POST (test, contrôle de santé, proxy).
  body          String?
  /// Flux d'actualités RSS ou Atom (reconnu à la première réponse) : lu par /api/widgets/feeds.
  feed          Boolean   @default(false)
  widgets       String[]  @default([])
  /// Date du dernier changement d'endpoint : la latence médiane ne compte que les appels postérieurs.
  endpointSince DateTime? @map("endpoint_since")
  lastTest      Json?     @map("last_test")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  updatedBy     String?   @map("updated_by")
  version       Int       @default(1)

  @@map("api_cards")
}

/// Appel sortant d'une carte (proxy, contrôle de santé, test) : latence sur 24 h et quota du jour.
model ApiCardCall {
  id     String   @id @default(cuid())
  at     DateTime @default(now())
  cardId String   @map("card_id")
  code   Int
  ms     Int?
  source String
  widget String?

  @@index([cardId, at])
  @@map("api_card_calls")
}

/// Dictionnaire des données du Jev de la Console (Text-to-SQL) : une fiche par vue du schéma `jev`.
/// Contenu chargé par `prisma/seed/dictionnaire.ts` depuis `src/domain/jev-dictionnaire.ts`.
model DictionnaireTable {
  /// Espace décrit : console (schéma jev) ou cockpit (schéma jev_cockpit)
  espace      String                @default("console")
  /// Nom de la vue interrogeable, sans le schéma
  nom         String
  description String
  /// Clés et jointures vers les autres vues, une par ligne
  relations   String                @default("")
  /// Questions auxquelles la vue répond, agrégations, filtres fréquents, un par ligne
  usages      String                @default("")
  /// Règles de calcul et précautions (valeurs nulles, statuts, fuseau, droits…), une par ligne
  regles      String                @default("")
  /// Fiche envoyée au modèle
  actif       Boolean               @default(true)
  position    Int                   @default(0)
  version     Int                   @default(1)
  modifieLe   DateTime              @updatedAt @map("modifie_le")
  modifiePar  String?               @map("modifie_par")
  colonnes    DictionnaireColonne[]

  @@id([espace, nom])
  @@map("dictionnaire_tables")
}

/// Une colonne d'une vue du dictionnaire.
model DictionnaireColonne {
  espace         String            @default("console")
  tableNom       String            @map("table_nom")
  table          DictionnaireTable @relation(fields: [espace, tableNom], references: [espace, nom], onDelete: Cascade)
  nom            String
  /// texte, entier, décimal, booléen, date, date-heure, json, liste de textes, liste d’entiers
  type           String
  signification  String
  /// Valeurs possibles, exemples ou unité (€, ms, %, jetons)
  exemplesUnites String?           @map("exemples_unites")
  position       Int               @default(0)

  @@id([espace, tableNom, nom])
  @@map("dictionnaire_colonnes")
}

/// Serveur d'envoi SMTP (spécification SMTP) : une seule ligne (id « smtp »). Absente, les réglages viennent des
/// variables d'environnement (SMTP_HOST…). Le mot de passe est chiffré (AES-256-GCM) et n'est jamais renvoyé.
model SmtpSettings {
  id                String    @id @default("smtp")
  host              String
  port              Int
  /// Chiffrement : starttls, ssl ou none
  enc               String
  auth              Boolean   @default(true)
  user              String    @default("")
  passwordEncrypted String?   @map("password_encrypted")
  fromAddress       String    @map("from_address")
  /// Dernier test de connexion des réglages enregistrés : { ok, step, code, ms, at }
  lastTest          Json?     @map("last_test")
  lastOkAt          DateTime? @map("last_ok_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by")
  version           Int       @default(1)

  @@map("smtp_settings")
}

/// Notification d'un utilisateur du Cockpit (canal « Dans l'application » d'une règle) : cloche et tiroir du Cockpit.
model UserNotification {
  id         String    @id @default(cuid())
  accountId  String    @map("account_id")
  ruleId     String?   @map("rule_id")
  deliveryId String?   @map("delivery_id")
  projectId  String?   @map("project_id")
  title      String
  body       String
  createdAt  DateTime  @default(now()) @map("created_at")
  readAt     DateTime? @map("read_at")

  @@index([accountId, createdAt])
  @@map("user_notifications")
}

/// Conversation d'un administrateur avec le Jev de la Console (mémoire, décision du 30/09/2026) : propre au compte,
/// supprimée au bout de JEV_CONVERSATION_RETENTION_DAYS jours sans échange.
model JevConversation {
  id              String       @id
  accountId       String       @map("account_id")
  account         Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Résumé des échanges sortis de la fenêtre envoyée au modèle.
  summary         String?
  /// Nombre de messages (les plus anciens) déjà repris dans le résumé.
  summarizedCount Int          @default(0) @map("summarized_count")
  /// Application (console, cockpit) et projet (Cockpit) de la conversation (décision du 01/10/2026).
  app             String       @default("console")
  projectId       String?      @map("project_id")
  /// Cockpit, cas 3 : modification en cours de préparation (opérations résolues, question posée), ou null.
  draft           Json?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  messages        JevMessage[]

  @@index([accountId, updatedAt])
  @@index([accountId, app, projectId, updatedAt])
  @@map("jev_conversations")
}

/// Message d'une conversation avec Jev : question de l'administrateur (user) ou réponse de Jev (assistant).
model JevMessage {
  seq            Int             @id @default(autoincrement())
  conversationId String          @map("conversation_id")
  conversation   JevConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  text           String
  /// Sources de la réponse : vues du dictionnaire (DONNÉES) ou sections et pages du guide (USAGE).
  sources        String[]        @default([])
  /// Type de la question (aiguillage : USAGE, DONNEES, AMBIGU, HORS_SUJET) et question reformulée (questions de suite).
  route          String?
  reformulated   String?
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([conversationId, seq])
  @@map("jev_messages")
}

/// Occurrence d'un envoi planifié (règle × projet × heure prévue) : mémoire des envois (décision du 30/09/2026). Unique :
/// une occurrence n'est enregistrée, donc envoyée, qu'une fois, même après plusieurs redémarrages.
model NotificationOccurrence {
  id          String    @id @default(cuid())
  ruleId      String    @map("rule_id")
  projectId   String    @map("project_id")
  scheduledAt DateTime  @map("scheduled_at")
  /// Limite de rattrapage : lendemain du jour prévu, 23:59, fuseau du projet.
  deadline    DateTime
  /// QUEUED (à envoyer), SENDING (en cours), SENT, REPLACED, MISSED, CANCELLED (règle désactivée ou supprimée).
  status      String
  /// ON_TIME ou CATCH_UP, fixé à l'envoi.
  mode        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  doneAt      DateTime? @map("done_at")

  @@unique([ruleId, projectId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("notification_occurrences")
}

/// Guide utilisateur de la Console (décision du 30/09/2026) : une version par dépôt ; la plus récente est en vigueur,
/// seule téléchargeable. Les versions remplacées restent dans l'historique ; leur fichier n'est plus servi.
model GuideVersion {
  id         String   @id @default(cuid())
  /// Application du guide : console ou cockpit (décision du 30/09/2026) ; aucune donnée partagée entre les deux.
  app        String   @default("console")
  /// Ordre de publication (indépendant de l'horloge) : la plus grande valeur est la version en vigueur.
  seq        Int      @default(autoincrement())
  /// Numéro « majeur.mineur », incrément mineur automatique à chaque dépôt (3.2 → 3.3), propre à l'application.
  v          String
  at         DateTime
  accountId  String?  @map("account_id")
  by         String
  size       Int
  fileName   String   @map("file_name")
  /// Fichier de la version ; vide une fois la version remplacée (un seul guide conservé, décision du 30/09/2026).
  storageKey String   @map("storage_key")
  /// Dépôt qui a produit cette version (indexation réussie).
  uploadId   String?  @map("upload_id")
  pages      Int?
  chunks     Int?

  @@unique([app, v])
  @@map("guide_versions")
}

enum GuideUploadStatus {
  INDEXING
  SUCCESS
  FAILED
}

/// Historique des dépôts du guide (décision du 30/09/2026) : un par dépôt, réussi ou non. Un seul dépôt INDEXING à la
/// fois (index unique partiel, migration). Le modèle d'embedding est conservé (id et nom) : l'historique reste lisible
/// si le modèle est supprimé ensuite.
model GuideUpload {
  id             String            @id @default(cuid())
  app            String            @default("console")
  at             DateTime
  accountId      String?           @map("account_id")
  by             String
  fileName       String            @map("file_name")
  size           Int
  pages          Int?
  chunks         Int?
  status         GuideUploadStatus
  /// Étape en cours (1 à 5) et son libellé ; avancement en pourcentage.
  step           Int               @default(0)
  stepLabel      String?           @map("step_label")
  progress       Int               @default(0)
  error          String?
  /// Version attribuée en cas de succès.
  version        String?
  storageKey     String?           @map("storage_key")
  embeddingModel String?           @map("embedding_model")
  embeddingName  String?           @map("embedding_name")
  embeddingDims  Int?              @map("embedding_dims")
  finishedAt     DateTime?         @map("finished_at")
  extracts       GuideChunk[]

  @@index([at])
  @@map("guide_uploads")
}

/// Extrait indexé du guide (chunk) et son vecteur (pgvector, dimension variable ; index HNSW partiel par dimension).
model GuideChunk {
  id          String                @id @default(cuid())
  uploadId    String                @map("upload_id")
  position    Int
  sectionPath String                @map("section_path")
  heading     String
  pageStart   Int                   @map("page_start")
  pageEnd     Int                   @map("page_end")
  content     String
  tokens      Int
  dims        Int
  embedding   Unsupported("vector")
  upload      GuideUpload           @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId])
  @@map("guide_chunks")
}

/// Téléchargement du guide, tracé par le serveur avant l'envoi du fichier : journal en ajout seul (ni modification ni
/// suppression, trigger SQL).
model GuideDownload {
  id        String   @id @default(cuid())
  app       String   @default("console")
  accountId String?  @map("account_id")
  user      String
  role      String?
  at        DateTime
  version   String

  @@index([at])
  @@map("guide_downloads")
}

/// Classification d'une question posée à Jev (aiguillage, décision du 30/09/2026) : une ligne par question, pour
/// analyser les erreurs. `status` : OK, ou motif du repli (ERROR, TIMEOUT, INVALID, NOT_CONFIGURED).
model JevClassification {
  id             String   @id @default(cuid())
  at             DateTime
  accountId      String?  @map("account_id")
  conversationId String?  @map("conversation_id")
  question       String
  /// Type retenu (USAGE, DONNEES, AMBIGU, HORS_SUJET) ; en repli, AMBIGU.
  type           String
  choice         String?
  confidence     Float?
  probabilities  Json?
  latencyMs      Int?     @map("latency_ms")
  status         String
  error          String?
  promptVersion  String   @map("prompt_version")
  model          String?
  /// LIVE (question réelle) ou EVAL (jeu de test).
  source         String   @default("LIVE")
  /// Application d'où vient la question (console, cockpit). Dans le Cockpit, `type` porte le cas d'usage (1, 2, 3, 4a, 4b, 5).
  app            String   @default("console")
  /// Cockpit : probabilités des questions oui / non « demande d'écriture » et « plusieurs demandes ».
  writeScore     Float?   @map("write_score")
  multiScore     Float?   @map("multi_score")
  multi          Boolean?
  /// Cockpit : modèle d'IA qui a rédigé la réponse (fonction du cas), renseigné après la réponse.
  answerModel    String?  @map("answer_model")

  @@index([at])
  @@index([app, at])
  @@map("jev_classifications")
}

/// Réglages de la recherche de Jev dans le guide utilisateur (RAG, décision du 30/09/2026) : une seule ligne
/// (`id = default`), modifiable depuis la Console ; valeurs par défaut du code si la ligne n'existe pas.
model JevRagSettings {
  /// Application : console ou cockpit (une ligne chacune).
  id              String   @id
  /// Extraits recherchés dans pgvector, puis gardés après reclassement.
  searchK         Int      @map("search_k")
  keepK           Int      @map("keep_k")
  /// Similarité cosinus minimale d'un extrait (0 à 1).
  minSimilarity   Float    @map("min_similarity")
  /// Délais d'expiration (ms) : vectorisation de la question, reclassement, rédaction.
  embedTimeoutMs  Int      @map("embed_timeout_ms")
  rerankTimeoutMs Int      @map("rerank_timeout_ms")
  llmTimeoutMs    Int      @map("llm_timeout_ms")
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedBy       String?  @map("updated_by")

  @@map("jev_rag_settings")
}

/// Journal technique d'une réponse de Jev (décision du 30/09/2026) : type, traitement, extraits retenus et scores,
/// reclassement utilisé ou repli, modèles appelés, temps par étape, erreurs. Les données brutes ne vont pas en mémoire.
model JevAnswerLog {
  id               String   @id @default(cuid())
  at               DateTime
  accountId        String?  @map("account_id")
  conversationId   String?  @map("conversation_id")
  classificationId String?  @map("classification_id")
  question         String
  reformulated     String?
  route            String
  /// DONNEES, GUIDE (recherche dans le guide), CLARIFICATION.
  treatment        String
  /// Motif du passage en clarification (AMBIGU, HORS_SUJET, AUCUN_EXTRAIT, GUIDE_NON_INDEXE, INDISPONIBLE).
  reason           String?
  extracts         Json?
  reranker         String?
  rerankFallback   String?  @map("rerank_fallback")
  model            String?
  timings          Json?
  totalMs          Int?     @map("total_ms")
  /// Requête SQL exécutée (traitement DONNÉES), pour l'analyse.
  sql              String?
  error            String?

  @@index([at])
  @@map("jev_answer_logs")
}

/// Trace d’une question posée à Jev (01/10/2026) : étapes chronométrées, imbriquées, de la question à la réponse
/// (`src/core/trace.ts`). Conservée 30 jours ; lue par `npm run jev:traces`.
model JevTrace {
  id      String   @id
  at      DateTime
  /// « Jev Cockpit », « Jev Console ».
  label   String
  totalMs Int      @map("total_ms")
  /// Projet, question (début), cas d’usage, conversation, erreur éventuelle.
  meta    Json
  /// Étapes : { i, depth, parent, name, at, ms, detail?, error? }.
  spans   Json

  @@index([at])
  @@map("jev_traces")
}

/// Temps de traitement de Jev (spécification TEMPS § 3, 01/10/2026) : une ligne par étape exécutée d'un prompt
/// (route, vec, rrk, qry, exe, gen) et une ligne `e2e` par prompt, mesurée directement. Conservées 190 jours.
model StepTiming {
  id           BigInt   @id @default(autoincrement())
  requestId    String   @map("request_id")
  /// guide_cockpit, guide_console, data_cockpit, data_console, update_cockpit, kb_document.
  category     String
  /// route, vec, rrk, qry, exe, gen ou e2e.
  step         String
  /// Identifiant du modèle d'IA, « jev-typesafe » (aiguillage) ou « svc » (traitement interne).
  model        String
  /// primary ou fallback.
  role         String
  startedAt    DateTime @map("started_at")
  endedAt      DateTime @map("ended_at")
  durationMs   Int      @map("duration_ms")
  errorType    String?  @map("error_type")
  errorMessage String?  @map("error_message")

  @@index([startedAt])
  @@map("step_timings")
}

/// Message d'accueil de l'écran Aujourd'hui rédigé par Jev (02/10/2026) : une seule génération par compte, projet et
/// jour (fuseau du projet), réussie ou non ; `status` JEV (texte gardé), REFUSE (contrôle de la réponse) ou ECHEC
/// (modèle indisponible) ; dans ces deux cas, l'écran garde le message calculé par règles. Purge à 30 jours.
model TodayGreeting {
  id            String   @id @default(cuid())
  accountId     String
  projectId     String
  day           String
  status        String
  text          String?
  reason        String?
  modelId       String?
  promptVersion String
  createdAt     DateTime @default(now())

  @@unique([accountId, projectId, day])
  @@index([createdAt])
  @@map("today_greetings")
}

/// Fichier chargé à l'étape « Format du rapport » (02/10/2026) : PowerPoint, PDF ou image, analysé au dépôt.
model ReportFormatFile {
  id         String   @id
  projectId  String
  fileName   String
  /// PPTX | PDF | IMAGE
  kind       String
  sizeBytes  Int
  fileKey    String
  /// Analyse (FormatAnalysis, `domain/report-format.ts`)
  analysis   Json
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@map("report_format_files")
}

/// Version publiée d'un template de rapport (03/10/2026) : PowerPoint de référence (structure figée, design, zones
/// variables) et manifeste des zones ; toute modification de structure crée une nouvelle version.
/// Brouillon de « Créer un template » (04/10/2026) : un par compte et par projet, enregistré à chaque modification.
model ReportTemplateDraft {
  id        String   @id
  projectId String
  accountId String
  /// État de l'assistant : étape, fiche, format (pages, rôles, statut vérifié), composants (ordre, sections, données)
  data      Json
  updatedAt DateTime @updatedAt

  @@unique([projectId, accountId])
  @@map("report_template_drafts")
}

model ReportTemplateVersion {
  id         String   @id
  templateId String
  projectId  String
  seq        Int
  label      String
  fileKey    String
  /// TemplateManifest (`core/report-template.ts`)
  manifest   Json
  /// Structure publiée : composants, sections, format (instantané)
  structure  Json
  pages      Int
  createdBy  String?
  createdAt  DateTime @default(now())

  @@unique([templateId, seq])
  @@index([projectId])
  @@map("report_template_versions")
}
