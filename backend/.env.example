# Base PostgreSQL 15+ (développement) et base de test dédiée (npm test)
DATABASE_URL=postgresql://rise:rise@localhost:5432/rise
DATABASE_URL_TEST=postgresql://rise:rise@localhost:5432/rise_test
# Jetons JWT
JWT_SECRET=dev-secret-change-me
JWT_TTL=12h
# Connexion de développement POST /api/auth/dev-login (jamais en production)
AUTH_DEV=true
# Date du jour de démonstration (brief § 7.1) ; vide = date réelle dans le fuseau du projet
DEMO_TODAY=
# Instant de démonstration de la console (facultatif), ex. 2026-09-26T08:24:00Z
DEMO_NOW=
# Clé maître AES-256-GCM des clés API des fournisseurs (64 caractères hexadécimaux)
SECRETS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Stockage des fichiers (documents, rapports, snapshots, imports)
STORAGE_DIR=./storage
# Port HTTP et dossier des frontends servis en statique (vide = non servis)
PORT=3000
FRONTEND_DIR=../frontends
# Tâches de fond pg-boss (tests de clés, alertes, snapshots, notifications, purge)
JOBS_ENABLED=true
# Services externes (météo, actualités) désactivés si true
OFFLINE=false
# Envoi d'e-mails : réglages initiaux du serveur SMTP, tant qu'ils ne sont pas enregistrés dans la Console
# (Plateforme › Serveur d'envoi SMTP, qui fait foi ensuite). Aucun identifiant réel dans le dépôt : à renseigner
# dans le .env local. Mot de passe : saisi dans la Console (chiffré en base) ou SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=
SMTP_ENC=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Ancienne forme (smtp://user:pass@host:587), lue si SMTP_HOST est vide ; rien de configuré = journal applicatif
SMTP_URL=
MAIL_FROM=RISE <no-reply@rise.local>
# Authentification : attribut Secure des cookies de session (false uniquement pour un accès http hors localhost)
COOKIE_SECURE=true
# Adresse publique de l'application (liens des e-mails de réinitialisation et d'invitation)
APP_URL=http://localhost:3000
# Contrôle complémentaire des mots de passe compromis par l'API Have I Been Pwned (k-anonymat)
PWNED_CHECK=false
# Mandataire inverse devant l'API (adresse IP réelle pour le blocage par IP), ex. 1 ; vide = aucun
TRUST_PROXY=
# Compte initial : le mot de passe provisoire (RISE_INITIAL_ADMIN_PASSWORD) ne s'écrit pas ici.
# outils/start_cockpit.ps1 le demande en saisie masquée ; sinon : RISE_INITIAL_ADMIN_PASSWORD='…' npm run init:admin
