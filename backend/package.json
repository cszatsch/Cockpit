{
  "name": "rise-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend RISE Cockpit + Console Admin",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "ts-node --transpile-only prisma/seed/index.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run db:seed",
    "init:admin": "ts-node --transpile-only scripts/init-admin.ts",
    "ia:reinitialiser": "ts-node --transpile-only scripts/reset-ai.ts",
    "ia:catalogue": "ts-node --transpile-only scripts/ia-catalogue.ts",
    "dictionnaire:charger": "ts-node --transpile-only prisma/seed/dictionnaire.ts",
    "dictionnaire:doc": "ts-node --transpile-only scripts/dictionnaire-doc.ts",
    "openapi": "ts-node --transpile-only scripts/export-openapi.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand test/unit",
    "test:e2e": "jest --runInBand test/e2e"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed/index.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.19.3",
    "exceljs": "^4.4.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.11",
    "pdfjs-dist": "3.11.174",
    "pg-boss": "^10.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^7.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/standalone": "^7.29.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "playwright": "^1.55.0",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.6"
  }
}
